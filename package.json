{
  "name": "church-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A theological compatibility tool for discerning which local church to sit under, and moving from browsing to committed membership.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
